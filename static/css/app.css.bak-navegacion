:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-soft: #eff6ff;

    --success: #16a34a;
    --warning: #d97706;
    --danger: #dc2626;

    --dark: #111827;
    --text: #172033;
    --muted: #667085;

    --page: #f4f7fb;
    --card: #ffffff;
    --border: #e5eaf1;

    --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
    --shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
    --shadow-lg: 0 18px 45px rgba(15, 23, 42, 0.10);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background:
        radial-gradient(
            circle at top right,
            rgba(37, 99, 235, 0.055),
            transparent 32rem
        ),
        var(--page);
    color: var(--text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

/* ============================================================
   MAIN CONTAINER
   ============================================================ */

.container {
    max-width: 1450px;
}

/* ============================================================
   HEADER
   ============================================================ */

.header {
    position: relative;
    overflow: hidden;
    padding: 26px 30px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background:
        linear-gradient(
            135deg,
            #111827 0%,
            #172554 100%
        );
    color: white;
    box-shadow: var(--shadow-lg);
}

.header::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -80px;
    top: -100px;
    border-radius: 50%;
    background: rgba(255,255,255,0.07);
}

.header > * {
    position: relative;
    z-index: 1;
}

.header h1 {
    margin: 0 0 6px;
    color: white;
    font-size: 1.5rem;
    font-weight: 850;
    letter-spacing: -0.5px;
}

.header p {
    color: rgba(255,255,255,0.65) !important;
    font-size: 0.86rem;
}

.header .badge {
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    background: rgba(255,255,255,0.08) !important;
    color: rgba(255,255,255,0.88);
    font-size: 0.67rem;
}

/* ============================================================
   ALERT
   ============================================================ */

.alert {
    border-radius: 14px;
    border-width: 1px;
}

/* ============================================================
   STATS
   ============================================================ */

.stat-card {
    position: relative;
    min-height: 112px;
    padding: 20px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-left-width: 4px;
    border-radius: 16px;
    background: var(--card);
    box-shadow: var(--shadow-sm);
    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
}

.stat-card::after {
    content: "";
    position: absolute;
    width: 75px;
    height: 75px;
    right: -25px;
    bottom: -35px;
    border-radius: 50%;
    background: var(--primary-soft);
}

.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
}

.stat-icon {
    position: relative;
    z-index: 1;
    margin-bottom: 7px;
    font-size: 22px;
}

.stat-number {
    position: relative;
    z-index: 1;
    color: var(--dark);
    font-size: 1.7rem;
    line-height: 1;
    font-weight: 850;
}

.stat-title {
    position: relative;
    z-index: 1;
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.69rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.stat-card.interview {
    border-left-color: #dc2626;
}

.stat-card.admission {
    border-left-color: #16a34a;
}

.stat-card.test {
    border-left-color: #7c3aed;
}

.stat-card.followup {
    border-left-color: #d97706;
}

.stat-card.application {
    border-left-color: #2563eb;
}

.stat-card.offer {
    border-left-color: #059669;
}

.stat-card.rejected {
    border-left-color: #64748b;
}

/* ============================================================
   SECTION HEADERS
   ============================================================ */

.section-header {
    margin-bottom: 17px;
}

.section-header h2 {
    margin-bottom: 4px;
    color: var(--dark);
    font-size: 1.15rem;
    font-weight: 850;
    letter-spacing: -0.3px;
}

.section-header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
}

/* ============================================================
   PRIORITY
   ============================================================ */

.priority-section {
    padding: 22px;
    border: 1px solid #f5d77a;
    border-radius: 19px;
    background: #fffdf5;
    box-shadow: var(--shadow-sm);
}

.priority-header {
    padding: 16px;
    border-radius: 13px;
    background: #fff8dd;
}

.priority-header h2 {
    color: #92400e;
}

/* ============================================================
   JOB CARDS
   ============================================================ */

.job-card {
    position: relative;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 17px;
    background: var(--card);
    box-shadow: var(--shadow-sm);
    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease;
}

.job-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    border-radius: 17px 17px 0 0;
    background: linear-gradient(
        90deg,
        var(--primary),
        #60a5fa
    );
    opacity: 0;
    transition: opacity 0.18s ease;
}

.job-card:hover {
    transform: translateY(-2px);
    border-color: #d2dceb;
    box-shadow: var(--shadow);
}

.job-card:hover::before {
    opacity: 1;
}

.priority-card {
    border-left: 4px solid #dc2626;
}

.job-card h3 {
    margin-bottom: 0;
    color: var(--dark);
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.2px;
}

/* ============================================================
   COMPANY / EMAIL
   ============================================================ */

.company {
    margin-top: 13px;
    margin-bottom: 8px;
    color: #344054;
    font-size: 0.88rem;
    font-weight: 750;
}

.email-info {
    margin-bottom: 13px;
    color: var(--muted);
    font-size: 0.72rem;
}

/* ============================================================
   STATUS
   ============================================================ */

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 0.63rem;
    font-weight: 800;
}

.status-badge.interview {
    background: #fef2f2;
    color: #b42318;
    border: 1px solid #fecaca;
}

.status-badge.admission {
    background: #ecfdf3;
    color: #087443;
    border: 1px solid #bbf7d0;
}

.status-badge.test {
    background: #f5f3ff;
    color: #6d28d9;
    border: 1px solid #ddd6fe;
}

.status-badge.followup {
    background: #fff7ed;
    color: #b45309;
    border: 1px solid #fed7aa;
}

.status-badge.application {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
}

.status-badge.offer {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
}

.status-badge.rejected {
    background: #f2f4f7;
    color: #475467;
    border: 1px solid #e4e7ec;
}

/* ============================================================
   SCORE
   ============================================================ */

.score {
    min-width: 70px;
    color: var(--primary);
    font-size: 1.45rem;
    font-weight: 850;
    text-align: right;
}

.score small {
    display: block;
    margin-top: 2px;
    color: #98a2b3;
    font-size: 0.56rem;
    font-weight: 700;
}

/* ============================================================
   SKILLS
   ============================================================ */

.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 14px 0;
}

.skill {
    padding: 4px 8px;
    border: 1px solid #e4e7ec;
    border-radius: 7px;
    background: #f8fafc;
    color: #475467;
    font-size: 0.61rem;
    font-weight: 700;
}

/* ============================================================
   SUBJECT
   ============================================================ */

.subject {
    margin-top: 14px;
    padding: 11px 13px;
    border: 1px solid #edf1f5;
    border-radius: 10px;
    background: #f8fafc;
    color: #475467;
    font-size: 0.72rem;
    line-height: 1.5;
}

.subject strong {
    color: #344054;
}

/* ============================================================
   ACTIONS
   ============================================================ */

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 17px;
}

.actions .btn {
    min-height: 38px;
    padding: 0 14px;
    border-radius: 9px;
    font-size: 0.69rem;
    font-weight: 750;
}

.actions .btn-dark {
    border: none;
    background: #111827;
}

.actions .btn-primary {
    border: none;
    background: linear-gradient(
        135deg,
        var(--primary),
        var(--primary-dark)
    );
}

/* ============================================================
   EMPTY
   ============================================================ */

.empty-state {
    padding: 70px 20px;
    border: 1px dashed #cbd5e1;
    border-radius: 18px;
    background: white;
    text-align: center;
    box-shadow: var(--shadow-sm);
}

.empty-state div {
    margin-bottom: 15px;
    font-size: 45px;
}

.empty-state h3 {
    color: var(--dark);
    font-size: 1.1rem;
    font-weight: 800;
}

.empty-state p {
    color: var(--muted);
    font-size: 0.8rem;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 767px) {
    .header {
        padding: 21px;
    }

    .header .badge {
        display: none;
    }

    .job-card {
        padding: 18px;
    }

    .actions {
        flex-direction: column;
    }

    .actions .btn {
        width: 100%;
    }
}
