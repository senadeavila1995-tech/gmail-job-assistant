<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>Gmail Job Assistant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/app.css') }}"
    >
</head>

<body>

<div class="container py-4">

    <!-- HEADER -->

    <div class="header mb-4">

        <div>
            <h1>Gmail Job Assistant</h1>

            <p class="text-muted mb-0">
                Tu proceso laboral organizado automáticamente
            </p>
        </div>

        <div class="badge bg-dark">
            Gmail · Solo lectura
        </div>

    </div>


    {% if error %}

    <div class="alert alert-danger">

        <strong>Error:</strong>

        {{ error }}

    </div>

    {% endif %}


    <!-- RESUMEN POR ESTADO -->

    <div class="row g-3 mb-4" id="status-summary">

        {% set summary_statuses = [
            "ENTREVISTA",
            "ADMISION",
            "PRUEBA",
            "SEGUIMIENTO",
            "APLICADA",
            "OFERTA",
            "RECHAZADA"
        ] %}

        {% for summary_status in summary_statuses %}

        <div class="col-6 col-md-4 col-lg-3">

            <div class="stat-card stat-status-card"
                 data-status-counter="{{ summary_status }}">

                <div class="stat-icon">
                    {{ status_config[summary_status].icon }}
                </div>

                <div class="stat-content">

                    <div class="stat-number">
                        0
                    </div>

                    <div class="stat-title">
                        {{ status_config[summary_status].title }}
                    </div>

                </div>

            </div>

        </div>

        {% endfor %}

    </div>

    <!-- FILTRO DE MODALIDAD -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-md-8">

                    <label for="global-work-mode-filter"
                           class="form-label fw-semibold mb-1">
                        Filtrar por modalidad
                    </label>

                    <select id="global-work-mode-filter"
                            class="form-select">

                        <option value="TODAS">
                            Todas
                        </option>

                        <option value="REMOTO">
                            🟢 100% remoto
                        </option>

                        <option value="HIBRIDO">
                            🟡 Híbrido
                        </option>

                        <option value="PRESENCIAL">
                            🔴 No remoto / presencial
                        </option>

                        <option value="NO_DEFINIDO">
                            ⚪ Sin definir
                        </option>

                    </select>

                </div>

                <div class="col-md-4">

                    <div class="text-muted small mt-md-4">
                        Filtra las oportunidades sin cambiar
                        su estado ni eliminar información.
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PRIORIDAD -->

    {% if True %}

    <div class="priority-section mb-5">

        <div class="section-header priority-header">

            <div>

                <h2>🔥 Prioridad</h2>

                <p>
                    Procesos que pueden acercarte directamente
                    a una contratación.
                </p>

            </div>

        </div>


        {% for status in ["ENTREVISTA", "ADMISION"] %}

                <div
                    id="{% if status == 'ENTREVISTA' %}entrevistas{% else %}admision{% endif %}"
                    class="section-anchor"
                ></div>

                {% for email in grouped[status] %}

                <div
                    class="job-card priority-card mb-3"
                    data-work-mode="{{ email.work_mode }}"
                    data-status="{{ email.status }}"
                >

                    <div class="d-flex justify-content-between">

                        <div>

                            <span class="status-badge {{ email.status_config.class }}">

                                {{ email.status_config.icon }}

                                {{ email.status_config.title }}

                            </span>

                            <div class="work-mode-control mt-2 mb-2">

                                <label class="form-label small text-muted mb-1">
                                    Modalidad
                                </label>

                                <select class="form-select form-select-sm work-mode-select">

                                    <option value="REMOTO"
                                        {% if email.work_mode == "REMOTO" %}selected{% endif %}>
                                        🟢 100% remoto
                                    </option>

                                    <option value="HIBRIDO"
                                        {% if email.work_mode == "HIBRIDO" %}selected{% endif %}>
                                        🟡 Híbrido
                                    </option>

                                    <option value="PRESENCIAL"
                                        {% if email.work_mode == "PRESENCIAL" %}selected{% endif %}>
                                        🔴 No remoto / presencial
                                    </option>

                                    <option value="NO_DEFINIDO"
                                        {% if email.work_mode == "NO_DEFINIDO" %}selected{% endif %}>
                                        ⚪ Sin definir
                                    </option>

                                </select>

                            </div>
<h3 class="mt-2">
                                {{ email.position }}
                            </h3>

                        </div>

                        <div class="score">

                            {{ email.score }}%

                            <small>
                                compatibilidad
                            </small>

                        </div>

                    </div>


                    <div class="company">

                        🏢 {{ email.company }}

                    </div>


                    <div class="email-info">

                        📧 {{ email.sender }}

                        ·

                        🌐 {{ email.source }}

                        ·

                        📅 {{ email.date }}

                    </div>


                    {% if email.skills %}

                    <div class="skills">

                        {% for skill in email.skills %}

                        <span class="skill">
                            {{ skill }}
                        </span>

                        {% endfor %}

                    </div>

                    {% endif %}


                    <div class="subject">

                        <strong>Asunto:</strong>

                        {{ email.subject }}

                    </div>


                    <div class="actions">

                        <a
                            href="{{ email.gmail_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-dark"
                        >
                            📧 Abrir en Gmail
                        </a>

                        {% if email.url %}

                        <a
                            href="{{ email.url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-primary"
                        >
                            🟢 Ver oferta
                        </a>

                        {% endif %}

                    </div>

                </div>

                {% endfor %}


        {% endfor %}

    </div>

    {% endif %}


    <!-- RESTO DE ESTADOS -->

    {% for status in [
        "PRUEBA",
        "SEGUIMIENTO",
        "APLICADA",
        "OFERTA",
        "RECHAZADA"
    ] %}

        <section
            id="{% if status == 'PRUEBA' %}pruebas{% elif status == 'SEGUIMIENTO' %}seguimiento{% elif status == 'APLICADA' %}aplicaciones{% elif status == 'OFERTA' %}ofertas{% elif status == 'RECHAZADA' %}rechazadas{% endif %}"
            class="status-section mb-5 section-anchor-target"
        >

            <div class="section-header">

                <div>

                    <h2>

                        {{ status_config[status].icon }}

                        {{ status_config[status].title }}

                    </h2>

                    <p class="section-count">
                        {{ grouped[status]|length }}
                        correo(s)
                    </p>



                </div>

            </div>


            {% for email in grouped[status] %}

            <div
                class="job-card mb-3"
                data-work-mode="{{ email.work_mode }}"
                data-status="{{ email.status }}"
            >

                <div class="d-flex justify-content-between">

                    <div>

                        <span class="status-badge {{ email.status_config.class }}">

                            {{ email.status_config.icon }}

                            {{ email.status_config.title }}

                        </span>

                            <div class="work-mode-control mt-2 mb-2">

                                <label class="form-label small text-muted mb-1">
                                    Modalidad
                                </label>

                                <select class="form-select form-select-sm work-mode-select">

                                    <option value="REMOTO"
                                        {% if email.work_mode == "REMOTO" %}selected{% endif %}>
                                        🟢 100% remoto
                                    </option>

                                    <option value="HIBRIDO"
                                        {% if email.work_mode == "HIBRIDO" %}selected{% endif %}>
                                        🟡 Híbrido
                                    </option>

                                    <option value="PRESENCIAL"
                                        {% if email.work_mode == "PRESENCIAL" %}selected{% endif %}>
                                        🔴 No remoto / presencial
                                    </option>

                                    <option value="NO_DEFINIDO"
                                        {% if email.work_mode == "NO_DEFINIDO" %}selected{% endif %}>
                                        ⚪ Sin definir
                                    </option>

                                </select>

                            </div>
<h3 class="mt-2">
                            {{ email.position }}
                        </h3>

                    </div>


                    <div class="score">

                        {{ email.score }}%

                        <small>
                            compatibilidad
                        </small>

                    </div>

                </div>


                <div class="company">

                    🏢 {{ email.company }}

                </div>


                <div class="email-info">

                    📧 {{ email.sender }}

                    ·

                    🌐 {{ email.source }}

                    ·

                    📅 {{ email.date }}

                </div>


                {% if email.skills %}

                <div class="skills">

                    {% for skill in email.skills %}

                    <span class="skill">
                        {{ skill }}
                    </span>

                    {% endfor %}

                </div>

                {% endif %}


                <div class="subject">

                    <strong>Asunto:</strong>

                    {{ email.subject }}

                </div>


                <div class="actions">

                    <a
                        href="{{ email.gmail_url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-dark"
                    >
                        📧 Abrir en Gmail
                    </a>

                    {% if email.url %}

                    <a
                        href="{{ email.url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-outline-primary"
                    >
                        🟢 Ver oferta
                    </a>

                    {% endif %}

                </div>

            </div>

            {% endfor %}

        </section>


    {% endfor %}


    {% if not emails and not error %}

    <div class="empty-state">

        <div>
            📭
        </div>

        <h3>
            No encontramos procesos laborales
        </h3>

        <p>
            No hay correos que coincidan con las reglas actuales.
        </p>

    </div>

    {% endif %}


</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const modeSelects =
        document.querySelectorAll(".work-mode-select");

    const jobCards =
        document.querySelectorAll(".job-card");

    const globalFilter =
        document.getElementById("global-work-mode-filter");


    function normalizeMode(mode) {

        if (
            mode === "REMOTO" ||
            mode === "HIBRIDO" ||
            mode === "PRESENCIAL" ||
            mode === "NO_DEFINIDO"
        ) {
            return mode;
        }

        return "NO_DEFINIDO";
    }


    function normalizeStatus(status) {
        return (status || "").trim().toUpperCase();
    }


    function cardMatchesFilter(card, selectedMode) {

        if (selectedMode === "TODAS") {
            return true;
        }

        const select =
            card.querySelector(".work-mode-select");

        if (!select) {
            return false;
        }

        return normalizeMode(select.value) === selectedMode;
    }


    function updateDashboard() {

        const selectedMode =
            globalFilter
                ? globalFilter.value
                : "TODAS";


        // ====================================================
        // 1. MOSTRAR / OCULTAR OPORTUNIDADES
        // ====================================================

        jobCards.forEach(function (card) {

            const visible =
                cardMatchesFilter(
                    card,
                    selectedMode
                );

            card.style.display =
                visible ? "" : "none";

        });


        // ====================================================
        // 2. RECALCULAR TARJETAS SUPERIORES POR ESTADO
        // ====================================================

        const statusCounts = {};

        document
            .querySelectorAll("[data-status-counter]")
            .forEach(function (element) {

                const status =
                    normalizeStatus(
                        element.dataset.statusCounter
                    );

                statusCounts[status] = 0;

            });


        jobCards.forEach(function (card) {

            if (!cardMatchesFilter(
                card,
                selectedMode
            )) {
                return;
            }

            const status =
                normalizeStatus(
                    card.dataset.status
                );

            if (
                Object.prototype.hasOwnProperty.call(
                    statusCounts,
                    status
                )
            ) {
                statusCounts[status]++;
            }

        });


        document
            .querySelectorAll("[data-status-counter]")
            .forEach(function (element) {

                const status =
                    normalizeStatus(
                        element.dataset.statusCounter
                    );

                const number =
                    element.querySelector(".stat-number");

                if (number) {
                    number.textContent =
                        statusCounts[status] || 0;
                }

            });


        // ====================================================
        // 3. ACTUALIZAR CANTIDAD DE CADA SECCION
        // ====================================================

        document
            .querySelectorAll(
                ".priority-section, .status-section"
            )
            .forEach(function (section) {

                const cards =
                    section.querySelectorAll(".job-card");

                let visibleCount = 0;

                cards.forEach(function (card) {

                    if (
                        card.style.display !== "none"
                    ) {
                        visibleCount++;
                    }

                });


                const countElement =
                    section.querySelector(
                        ".section-count"
                    );

                if (countElement) {
                    countElement.textContent =
                        visibleCount + " correo(s)";
                }

            });

    }


    // ========================================================
    // CAMBIO DEL FILTRO GLOBAL
    // ========================================================

    if (globalFilter) {

        globalFilter.addEventListener(
            "change",
            function () {

                updateDashboard();

            }
        );

    }


    // ========================================================
    // CAMBIO DE MODALIDAD DE UNA OPORTUNIDAD
    //
    // IMPORTANTE:
    // Solo cambia la modalidad visual de esa card.
    // NO cambia data-status.
    // ========================================================

    modeSelects.forEach(function (select) {

        select.addEventListener(
            "change",
            function () {

                const card =
                    select.closest(".job-card");

                if (card) {

                    card.dataset.workMode =
                        normalizeMode(
                            select.value
                        );

                }

                updateDashboard();

            }
        );

    });


    // Conteo inicial.
    updateDashboard();

});
</script>

</body>

</html>
