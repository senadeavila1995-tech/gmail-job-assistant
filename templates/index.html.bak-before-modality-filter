<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>Gmail Job Assistant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/app.css') }}"
    >
</head>

<body>

<div class="container py-4">

    <!-- HEADER -->

    <div class="header mb-4">

        <div>
            <h1>Gmail Job Assistant</h1>

            <p class="text-muted mb-0">
                Tu proceso laboral organizado automáticamente
            </p>
        </div>

        <div class="badge bg-dark">
            Gmail · Solo lectura
        </div>

    </div>


    {% if error %}

    <div class="alert alert-danger">

        <strong>Error:</strong>

        {{ error }}

    </div>

    {% endif %}


    <!-- RESUMEN -->

    
    <!-- RESUMEN POR MODALIDAD -->

    <div class="row g-3 mb-5" id="modality-summary">

        <div class="col-6 col-md-3">
            <div class="stat-card stat-nav"
                 role="button"
                 tabindex="0"
                 data-mode-target="REMOTO">

                <div class="stat-icon">🟢</div>

                <div class="stat-content">

                    <div class="stat-number"
                         data-mode-counter="REMOTO">
                        0
                    </div>

                    <div class="stat-title">
                        100% remoto
                    </div>

                </div>

                <div class="stat-arrow">→</div>

                <div class="stat-hint">
                    Ver sección
                </div>

            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="stat-card stat-nav"
                 role="button"
                 tabindex="0"
                 data-mode-target="HIBRIDO">

                <div class="stat-icon">🟡</div>

                <div class="stat-content">

                    <div class="stat-number"
                         data-mode-counter="HIBRIDO">
                        0
                    </div>

                    <div class="stat-title">
                        Híbrido
                    </div>

                </div>

                <div class="stat-arrow">→</div>

                <div class="stat-hint">
                    Ver sección
                </div>

            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="stat-card stat-nav"
                 role="button"
                 tabindex="0"
                 data-mode-target="PRESENCIAL">

                <div class="stat-icon">🔴</div>

                <div class="stat-content">

                    <div class="stat-number"
                         data-mode-counter="PRESENCIAL">
                        0
                    </div>

                    <div class="stat-title">
                        No remoto / presencial
                    </div>

                </div>

                <div class="stat-arrow">→</div>

                <div class="stat-hint">
                    Ver sección
                </div>

            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="stat-card stat-nav"
                 role="button"
                 tabindex="0"
                 data-mode-target="NO_DEFINIDO">

                <div class="stat-icon">⚪</div>

                <div class="stat-content">

                    <div class="stat-number"
                         data-mode-counter="NO_DEFINIDO">
                        0
                    </div>

                    <div class="stat-title">
                        Sin definir
                    </div>

                </div>

                <div class="stat-arrow">→</div>

                <div class="stat-hint">
                    Ver sección
                </div>

            </div>
        </div>

    </div>



    <!-- FILTRO DE MODALIDAD -->

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-md-8">

                    <div class="text-muted small mt-md-4">
                        Las oportunidades no se eliminan.
                        Usa este filtro para mostrar la modalidad
                        laboral que te interese.
                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- PRIORIDAD -->

    {% if grouped.get("ENTREVISTA") or grouped.get("ADMISION") %}

    <div class="priority-section mb-5">

        <div class="section-header priority-header">

            <div>

                <h2>🔥 Prioridad</h2>

                <p>
                    Procesos que pueden acercarte directamente
                    a una contratación.
                </p>

            </div>

        </div>


        {% for status in ["ENTREVISTA", "ADMISION"] %}

            {% if grouped.get(status) %}

                <div
                    id="{% if status == 'ENTREVISTA' %}entrevistas{% else %}admision{% endif %}"
                    class="section-anchor"
                ></div>

                {% for email in grouped[status] %}

                <div
                    class="job-card priority-card mb-3"
                    data-work-mode="{{ email.work_mode }}"
                    data-status="{{ email.status }}"
                >

                    <div class="d-flex justify-content-between">

                        <div>

                            <span class="status-badge {{ email.status_config.class }}">

                                {{ email.status_config.icon }}

                                {{ email.status_config.title }}

                            </span>

                            <div class="work-mode-control mt-2 mb-2">

                                <label class="form-label small text-muted mb-1">
                                    Modalidad
                                </label>

                                <select class="form-select form-select-sm work-mode-select">

                                    <option value="REMOTO"
                                        {% if email.work_mode == "REMOTO" %}selected{% endif %}>
                                        🟢 100% remoto
                                    </option>

                                    <option value="HIBRIDO"
                                        {% if email.work_mode == "HIBRIDO" %}selected{% endif %}>
                                        🟡 Híbrido
                                    </option>

                                    <option value="PRESENCIAL"
                                        {% if email.work_mode == "PRESENCIAL" %}selected{% endif %}>
                                        🔴 No remoto / presencial
                                    </option>

                                    <option value="NO_DEFINIDO"
                                        {% if email.work_mode == "NO_DEFINIDO" %}selected{% endif %}>
                                        ⚪ Sin definir
                                    </option>

                                </select>

                            </div>
<h3 class="mt-2">
                                {{ email.position }}
                            </h3>

                        </div>

                        <div class="score">

                            {{ email.score }}%

                            <small>
                                compatibilidad
                            </small>

                        </div>

                    </div>


                    <div class="company">

                        🏢 {{ email.company }}

                    </div>


                    <div class="email-info">

                        📧 {{ email.sender }}

                        ·

                        🌐 {{ email.source }}

                        ·

                        📅 {{ email.date }}

                    </div>


                    {% if email.skills %}

                    <div class="skills">

                        {% for skill in email.skills %}

                        <span class="skill">
                            {{ skill }}
                        </span>

                        {% endfor %}

                    </div>

                    {% endif %}


                    <div class="subject">

                        <strong>Asunto:</strong>

                        {{ email.subject }}

                    </div>


                    <div class="actions">

                        <a
                            href="{{ email.gmail_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-dark"
                        >
                            📧 Abrir en Gmail
                        </a>

                        {% if email.url %}

                        <a
                            href="{{ email.url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-primary"
                        >
                            🟢 Ver oferta
                        </a>

                        {% endif %}

                    </div>

                </div>

                {% endfor %}

            {% endif %}

        {% endfor %}

    </div>

    {% endif %}


    <!-- RESTO DE ESTADOS -->

    {% for status in [
        "PRUEBA",
        "SEGUIMIENTO",
        "APLICADA",
        "OFERTA",
        "RECHAZADA"
    ] %}

        {% if grouped.get(status) %}

        <section
            id="{% if status == 'PRUEBA' %}pruebas{% elif status == 'SEGUIMIENTO' %}seguimiento{% elif status == 'APLICADA' %}aplicaciones{% elif status == 'OFERTA' %}ofertas{% elif status == 'RECHAZADA' %}rechazadas{% endif %}"
            class="status-section mb-5 section-anchor-target"
        >

            <div class="section-header">

                <div>

                    <h2>

                        {{ status_config[status].icon }}

                        {{ status_config[status].title }}

                    </h2>

                    <p class="section-count">
                        {{ grouped[status]|length }}
                        correo(s)
                    </p>

                    <div class="section-mode-counts"
                         data-section-mode-counts="{{ status }}">

                        <span data-section-mode="REMOTO">
                            🟢 Remoto: 0
                        </span>

                        <span data-section-mode="HIBRIDO">
                            🟡 Híbrido: 0
                        </span>

                        <span data-section-mode="PRESENCIAL">
                            🔴 Presencial: 0
                        </span>

                        <span data-section-mode="NO_DEFINIDO">
                            ⚪ Sin definir: 0
                        </span>

                    </div>

                </div>

            </div>


            {% for email in grouped[status] %}

            <div
                class="job-card mb-3"
                data-work-mode="{{ email.work_mode }}"
                data-status="{{ email.status }}"
            >

                <div class="d-flex justify-content-between">

                    <div>

                        <span class="status-badge {{ email.status_config.class }}">

                            {{ email.status_config.icon }}

                            {{ email.status_config.title }}

                        </span>

                            <div class="work-mode-control mt-2 mb-2">

                                <label class="form-label small text-muted mb-1">
                                    Modalidad
                                </label>

                                <select class="form-select form-select-sm work-mode-select">

                                    <option value="REMOTO"
                                        {% if email.work_mode == "REMOTO" %}selected{% endif %}>
                                        🟢 100% remoto
                                    </option>

                                    <option value="HIBRIDO"
                                        {% if email.work_mode == "HIBRIDO" %}selected{% endif %}>
                                        🟡 Híbrido
                                    </option>

                                    <option value="PRESENCIAL"
                                        {% if email.work_mode == "PRESENCIAL" %}selected{% endif %}>
                                        🔴 No remoto / presencial
                                    </option>

                                    <option value="NO_DEFINIDO"
                                        {% if email.work_mode == "NO_DEFINIDO" %}selected{% endif %}>
                                        ⚪ Sin definir
                                    </option>

                                </select>

                            </div>
<h3 class="mt-2">
                            {{ email.position }}
                        </h3>

                    </div>


                    <div class="score">

                        {{ email.score }}%

                        <small>
                            compatibilidad
                        </small>

                    </div>

                </div>


                <div class="company">

                    🏢 {{ email.company }}

                </div>


                <div class="email-info">

                    📧 {{ email.sender }}

                    ·

                    🌐 {{ email.source }}

                    ·

                    📅 {{ email.date }}

                </div>


                {% if email.skills %}

                <div class="skills">

                    {% for skill in email.skills %}

                    <span class="skill">
                        {{ skill }}
                    </span>

                    {% endfor %}

                </div>

                {% endif %}


                <div class="subject">

                    <strong>Asunto:</strong>

                    {{ email.subject }}

                </div>


                <div class="actions">

                    <a
                        href="{{ email.gmail_url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-dark"
                    >
                        📧 Abrir en Gmail
                    </a>

                    {% if email.url %}

                    <a
                        href="{{ email.url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-outline-primary"
                    >
                        🟢 Ver oferta
                    </a>

                    {% endif %}

                </div>

            </div>

            {% endfor %}

        </section>

        {% endif %}

    {% endfor %}


    {% if not emails and not error %}

    <div class="empty-state">

        <div>
            📭
        </div>

        <h3>
            No encontramos procesos laborales
        </h3>

        <p>
            No hay correos que coincidan con las reglas actuales.
        </p>

    </div>

    {% endif %}


</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const modeSelects =
        document.querySelectorAll(".work-mode-select");


    function normalizeMode(mode) {

        if (
            mode === "REMOTO" ||
            mode === "HIBRIDO" ||
            mode === "PRESENCIAL" ||
            mode === "NO_DEFINIDO"
        ) {
            return mode;
        }

        return "NO_DEFINIDO";
    }


    function updateModeCounters() {

        const globalCounts = {
            REMOTO: 0,
            HIBRIDO: 0,
            PRESENCIAL: 0,
            NO_DEFINIDO: 0
        };


        // ====================================================
        // CONTADORES GLOBALES
        // ====================================================

        modeSelects.forEach(function (select) {

            const mode =
                normalizeMode(select.value);

            globalCounts[mode]++;

        });


        document
            .querySelectorAll("[data-mode-counter]")
            .forEach(function (element) {

                const mode =
                    normalizeMode(
                        element.dataset.modeCounter
                    );

                element.textContent =
                    globalCounts[mode];

            });


        // ====================================================
        // CONTADORES DENTRO DE CADA LISTA
        // ====================================================

        document
            .querySelectorAll(".section-mode-counts")
            .forEach(function (container) {

                const section =
                    container.closest(".status-section");

                if (!section) {
                    return;
                }


                const counts = {
                    REMOTO: 0,
                    HIBRIDO: 0,
                    PRESENCIAL: 0,
                    NO_DEFINIDO: 0
                };


                section
                    .querySelectorAll(".work-mode-select")
                    .forEach(function (select) {

                        const mode =
                            normalizeMode(select.value);

                        counts[mode]++;

                    });


                const labels = {
                    REMOTO: "🟢 Remoto",
                    HIBRIDO: "🟡 Híbrido",
                    PRESENCIAL: "🔴 Presencial",
                    NO_DEFINIDO: "⚪ Sin definir"
                };


                Object.keys(counts).forEach(function (mode) {

                    const element =
                        container.querySelector(
                            '[data-section-mode="' +
                            mode +
                            '"]'
                        );

                    if (!element) {
                        return;
                    }

                    element.textContent =
                        labels[mode] +
                        ": " +
                        counts[mode];

                });

            });

    }


    // ========================================================
    // CAMBIO DE MODALIDAD DE UNA CARD
    // ========================================================

    modeSelects.forEach(function (select) {

        select.addEventListener("change", function () {

            const card =
                select.closest(".job-card");

            if (card) {
                card.dataset.workMode =
                    normalizeMode(select.value);
            }


            updateModeCounters();

        });

    });


    // Conteo inicial.
    updateModeCounters();


    // ========================================================
    // NAVEGACIÓN DE CARDS SUPERIORES
    // ========================================================

    const statCards =
        document.querySelectorAll(".stat-nav");


    statCards.forEach(function (card) {

        function navigateToMode() {

            const targetMode =
                card.dataset.modeTarget;

            if (!targetMode) {
                return;
            }


            const targetSelect =
                Array.from(modeSelects).find(
                    function (select) {

                        return normalizeMode(
                            select.value
                        ) === targetMode;

                    }
                );


            if (!targetSelect) {
                return;
            }


            const targetCard =
                targetSelect.closest(".job-card");


            if (!targetCard) {
                return;
            }


            targetCard.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });


            targetCard.classList.add(
                "section-highlight"
            );


            setTimeout(function () {

                targetCard.classList.remove(
                    "section-highlight"
                );

            }, 1200);

        }


        card.addEventListener(
            "click",
            navigateToMode
        );


        card.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    navigateToMode();

                }

            }
        );

    });

});
</script>

</body>

</html>
