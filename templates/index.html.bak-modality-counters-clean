<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>Gmail Job Assistant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/app.css') }}"
    >
</head>

<body>

<div class="container py-4">

    <!-- HEADER -->

    <div class="header mb-4">

        <div>
            <h1>Gmail Job Assistant</h1>

            <p class="text-muted mb-0">
                Tu proceso laboral organizado automáticamente
            </p>
        </div>

        <div class="badge bg-dark">
            Gmail · Solo lectura
        </div>

    </div>


    {% if error %}

    <div class="alert alert-danger">

        <strong>Error:</strong>

        {{ error }}

    </div>

    {% endif %}


    <!-- RESUMEN -->

    <div class="row g-3 mb-5">

        {% for status, config in status_config.items() %}

        <div class="col-6 col-md-4 col-lg-3">

            <div
                class="stat-card stat-nav {{ config.class }}"
                role="button"
                tabindex="0"
                data-target="{% if status == 'ENTREVISTA' %}#entrevistas{% elif status == 'ADMISION' %}#admision{% elif status == 'PRUEBA' %}#pruebas{% elif status == 'SEGUIMIENTO' %}#seguimiento{% elif status == 'APLICADA' %}#aplicaciones{% elif status == 'OFERTA' %}#ofertas{% elif status == 'RECHAZADA' %}#rechazadas{% endif %}"
                aria-label="Ir a {{ config.title }}"
            >

                <div class="stat-icon">
                    {{ config.icon }}
                </div>

                <div class="stat-content">

                    <div class="stat-number">
                        {{ stats.get(status, 0) }}
                    </div>

                    <div class="stat-title">
                        {{ config.title }}
                    </div>

                </div>

                <div class="stat-arrow">
                    →
                </div>

                <div class="stat-hint">
                    Ver sección
                </div>

            </div>

        </div>

        {% endfor %}

    </div>


    <!-- FILTRO DE MODALIDAD -->

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-md-4">

                    <label
                        for="workModeFilter"
                        class="form-label fw-semibold mb-1"
                    >
                        Modalidad laboral
                    </label>

                    <select
                        id="workModeFilter"
                        class="form-select"
                    >
                        <option value="TODAS">
                            Todas
                        </option>

                        <option value="REMOTO">
                            100% remoto
                        </option>

                        <option value="HIBRIDO">
                            Híbrido
                        </option>

                        <option value="PRESENCIAL">
                            No remoto / presencial
                        </option>

                        <option value="NO_DEFINIDO">
                            Sin definir
                        </option>
                    </select>

                </div>

                <div class="col-md-8">

                    <div class="text-muted small mt-md-4">
                        Las oportunidades no se eliminan.
                        Usa este filtro para mostrar la modalidad
                        laboral que te interese.
                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- PRIORIDAD -->

    {% if grouped.get("ENTREVISTA") or grouped.get("ADMISION") %}

    <div class="priority-section mb-5">

        <div class="section-header priority-header">

            <div>

                <h2>🔥 Prioridad</h2>

                <p>
                    Procesos que pueden acercarte directamente
                    a una contratación.
                </p>

            </div>

        </div>


        {% for status in ["ENTREVISTA", "ADMISION"] %}

            {% if grouped.get(status) %}

                <div
                    id="{% if status == 'ENTREVISTA' %}entrevistas{% else %}admision{% endif %}"
                    class="section-anchor"
                ></div>

                {% for email in grouped[status] %}

                <div
                    class="job-card priority-card mb-3"
                    data-work-mode="{{ email.work_mode }}"
                    data-status="{{ email.status }}"
                >

                    <div class="d-flex justify-content-between">

                        <div>

                            <span class="status-badge {{ email.status_config.class }}">

                                {{ email.status_config.icon }}

                                {{ email.status_config.title }}

                            </span>

                            <div class="mt-2 mb-2">

                                {% if email.status == "ADMISION" %}

                                <span class="badge bg-secondary">
                                    🎓 Admisión
                                </span>

                                {% elif email.work_mode == "REMOTO" %}

                                <span class="badge bg-success">
                                    🟢 100% remoto
                                </span>

                                {% elif email.work_mode == "HIBRIDO" %}

                                <span class="badge bg-warning text-dark">
                                    🟡 Híbrido
                                </span>

                                {% elif email.work_mode == "PRESENCIAL" %}

                                <span class="badge bg-danger">
                                    🔴 No remoto / presencial
                                </span>

                                {% else %}

                                <span class="badge bg-secondary">
                                    ⚪ Sin definir
                                </span>

                                {% endif %}

                            </div>

                            <h3 class="mt-2">
                                {{ email.position }}
                            </h3>

                        </div>

                        <div class="score">

                            {{ email.score }}%

                            <small>
                                compatibilidad
                            </small>

                        </div>

                    </div>


                    <div class="company">

                        🏢 {{ email.company }}

                    </div>


                    <div class="email-info">

                        📧 {{ email.sender }}

                        ·

                        🌐 {{ email.source }}

                        ·

                        📅 {{ email.date }}

                    </div>


                    {% if email.skills %}

                    <div class="skills">

                        {% for skill in email.skills %}

                        <span class="skill">
                            {{ skill }}
                        </span>

                        {% endfor %}

                    </div>

                    {% endif %}


                    <div class="subject">

                        <strong>Asunto:</strong>

                        {{ email.subject }}

                    </div>


                    <div class="actions">

                        <a
                            href="{{ email.gmail_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-dark"
                        >
                            📧 Abrir en Gmail
                        </a>

                        {% if email.url %}

                        <a
                            href="{{ email.url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-primary"
                        >
                            🟢 Ver oferta
                        </a>

                        {% endif %}

                    </div>

                </div>

                {% endfor %}

            {% endif %}

        {% endfor %}

    </div>

    {% endif %}


    <!-- RESTO DE ESTADOS -->

    {% for status in [
        "PRUEBA",
        "SEGUIMIENTO",
        "APLICADA",
        "OFERTA",
        "RECHAZADA"
    ] %}

        {% if grouped.get(status) %}

        <section
            id="{% if status == 'PRUEBA' %}pruebas{% elif status == 'SEGUIMIENTO' %}seguimiento{% elif status == 'APLICADA' %}aplicaciones{% elif status == 'OFERTA' %}ofertas{% elif status == 'RECHAZADA' %}rechazadas{% endif %}"
            class="status-section mb-5 section-anchor-target"
        >

            <div class="section-header">

                <div>

                    <h2>

                        {{ status_config[status].icon }}

                        {{ status_config[status].title }}

                    </h2>

                    <p>
                        {{ grouped[status]|length }}
                        correo(s)
                    </p>

                </div>

            </div>


            {% for email in grouped[status] %}

            <div
                class="job-card mb-3"
                data-work-mode="{{ email.work_mode }}"
                data-status="{{ email.status }}"
            >

                <div class="d-flex justify-content-between">

                    <div>

                        <span class="status-badge {{ email.status_config.class }}">

                            {{ email.status_config.icon }}

                            {{ email.status_config.title }}

                        </span>

                        <div class="mt-2 mb-2">

                            {% if email.status == "ADMISION" %}

                            <span class="badge bg-secondary">
                                🎓 Admisión
                            </span>

                            {% elif email.work_mode == "REMOTO" %}

                            <span class="badge bg-success">
                                🟢 100% remoto
                            </span>

                            {% elif email.work_mode == "HIBRIDO" %}

                            <span class="badge bg-warning text-dark">
                                🟡 Híbrido
                            </span>

                            {% elif email.work_mode == "PRESENCIAL" %}

                            <span class="badge bg-danger">
                                🔴 No remoto / presencial
                            </span>

                            {% else %}

                            <span class="badge bg-secondary">
                                ⚪ Sin definir
                            </span>

                            {% endif %}

                        </div>

                        <h3 class="mt-2">
                            {{ email.position }}
                        </h3>

                    </div>


                    <div class="score">

                        {{ email.score }}%

                        <small>
                            compatibilidad
                        </small>

                    </div>

                </div>


                <div class="company">

                    🏢 {{ email.company }}

                </div>


                <div class="email-info">

                    📧 {{ email.sender }}

                    ·

                    🌐 {{ email.source }}

                    ·

                    📅 {{ email.date }}

                </div>


                {% if email.skills %}

                <div class="skills">

                    {% for skill in email.skills %}

                    <span class="skill">
                        {{ skill }}
                    </span>

                    {% endfor %}

                </div>

                {% endif %}


                <div class="subject">

                    <strong>Asunto:</strong>

                    {{ email.subject }}

                </div>


                <div class="actions">

                    <a
                        href="{{ email.gmail_url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-dark"
                    >
                        📧 Abrir en Gmail
                    </a>

                    {% if email.url %}

                    <a
                        href="{{ email.url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-outline-primary"
                    >
                        🟢 Ver oferta
                    </a>

                    {% endif %}

                </div>

            </div>

            {% endfor %}

        </section>

        {% endif %}

    {% endfor %}


    {% if not emails and not error %}

    <div class="empty-state">

        <div>
            📭
        </div>

        <h3>
            No encontramos procesos laborales
        </h3>

        <p>
            No hay correos que coincidan con las reglas actuales.
        </p>

    </div>

    {% endif %}


</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    // -----------------------------------------------------
    // FILTRO DE MODALIDAD LABORAL
    // -----------------------------------------------------

    const workModeFilter =
        document.getElementById("workModeFilter");

    const jobCards =
        document.querySelectorAll(".job-card");

    function applyWorkModeFilter() {

        if (!workModeFilter) {
            return;
        }

        const selectedMode =
            workModeFilter.value;

        jobCards.forEach(function (card) {

            const workMode =
                card.dataset.workMode || "NO_DEFINIDO";

            const status =
                card.dataset.status || "";

            // ADMISION siempre permanece visible.
            if (status === "ADMISION") {

                card.style.display = "";

                return;
            }

            if (
                selectedMode === "TODAS" ||
                workMode === selectedMode
            ) {

                card.style.display = "";

            } else {

                card.style.display = "none";

            }

        });

    }

    if (workModeFilter) {

        workModeFilter.addEventListener(
            "change",
            applyWorkModeFilter
        );

        applyWorkModeFilter();
    }


    // -----------------------------------------------------
    // NAVEGACIÓN DE LAS TARJETAS DE RESUMEN
    // -----------------------------------------------------

    const statCards = document.querySelectorAll(".stat-nav");

    statCards.forEach(function (card) {

        function navigateToSection() {

            const target = card.dataset.target;

            if (!target) {
                return;
            }

            const section = document.querySelector(target);

            if (!section) {
                return;
            }

            section.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

            // Pequeño efecto visual al llegar
            const sectionTarget =
                section.classList.contains("section-anchor")
                    ? section.parentElement
                    : section;

            if (sectionTarget) {
                sectionTarget.classList.add("section-highlight");

                setTimeout(function () {
                    sectionTarget.classList.remove("section-highlight");
                }, 1200);
            }
        }

        card.addEventListener("click", navigateToSection);

        card.addEventListener("keydown", function (event) {

            if (event.key === "Enter" || event.key === " ") {

                event.preventDefault();

                navigateToSection();
            }

        });

    });

});
</script>

</body>

</html>
